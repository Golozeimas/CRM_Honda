{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/offers/unsubscribe", "function": { "functionId": "unsubscribeOffers", "region": "southamerica-east1" } },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
